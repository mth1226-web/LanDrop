{
  "name": "landrop",
  "version": "0.7.1",
  "description": "LanDrop - 同一LAN内のPC同士でドラッグ&ドロップだけでファイルを送受信するアプリ",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "build": {
    "appId": "com.landrop.app",
    "productName": "LanDrop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable"
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dir"
        },
        {
          "target": "zip"
        }
      ],
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "同じWi-Fi/LAN上の他の端末を見つけてファイルを送受信するために使用します。"
      }
    }
  },
  "dependencies": {
    "archiver": "^5.3.2",
    "extract-zip": "^2.0.1",
    "immer": "^10.1.1",
    "qrcode": "^1.5.4",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/archiver": "^5.3.4",
    "@types/node": "^20.14.8",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.5.2",
    "vite": "^5.3.1"
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "esbuild@0.21.5": true,
    "core-js@3.49.0": true
  }
}
